# ═══════════════════════════════════════════════════════════
# 元模型 / 元数据 / 业务数据 —— 对接 paas-platform-service
# ═══════════════════════════════════════════════════════════
# 配置此变量后，/metamodel 页面 + Agent 工具 + /api/meta/* 接口
# 全部切到真实 paas-platform-service（自动登录拿 JWT，401 自动重登）
METAREPO_API_BASE=http://127.0.0.1:18010

# 登录凭据（默认使用 seed 数据里的张伟 / 鸿阳科技）
# METAREPO_PHONE=13800000001
# METAREPO_PASSWORD=123456

# 租户 ID（与 paas-platform-service seed 数据对齐）
# DEFAULT_TENANT_ID=292193

# 如果已有 JWT 可直接填（跳过自动登录）
# METAREPO_TOKEN=eyJhbGc...

# ═══════════════════════════════════════════════════════════
# Agent LLM
# ═══════════════════════════════════════════════════════════
DOUBAO_API_KEY=651621e7-e495-4728-93ef-ed380e9ddcd1
