{
  "type": "SearchSourcePanel",
  "description": "搜索引用源面板，按类型分组折叠展示引用来源（知识库文档/网页/CRM数据），支持脚注联动和来源跳转。",
  "input_schema": {
    "type": "object",
    "properties": {
      "sources": {
        "type": "array",
        "description": "引用源列表",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["knowledge", "web", "crm"],
              "description": "来源类型"
            },
            "title": {
              "type": "string",
              "description": "来源标题"
            },
            "url": {
              "type": "string",
              "description": "来源链接（可选）"
            },
            "snippet": {
              "type": "string",
              "description": "命中片段摘要"
            },
            "score": {
              "type": "number",
              "description": "相关度分数"
            },
            "doc_id": {
              "type": "string",
              "description": "文档 ID（知识库类型）"
            },
            "section_title": {
              "type": "string",
              "description": "章节标题"
            }
          },
          "required": ["type", "title"]
        }
      },
      "query": {
        "type": "string",
        "description": "原始查询（用于高亮命中词）"
      },
      "total_count": {
        "type": "integer",
        "description": "总引用数"
      }
    },
    "required": ["sources"]
  },
  "skill_bindings": {
    "bind": ["knowledge_doc_search"],
    "prefer": ["web_search"]
  },
  "supported_model_names": ["searchResults", "relevantData"],
  "rendering_hints": {
    "display_mode": "side_panel",
    "grouped_by": "type",
    "collapsible_groups": true,
    "highlight_query": true,
    "max_visible_per_group": 5
  }
}
